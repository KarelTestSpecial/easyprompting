#!/bin/sh
# Chrome Web Store rejects an upload when manifest.description exceeds
# 132 characters, but only at upload time. Check it before every commit.
python3 - <<'PY'
import json
import sys

try:
    with open("easyprompting/manifest.json", encoding="utf-8") as fh:
        description = json.load(fh).get("description", "")
except Exception as exc:  # unreadable manifest should not silently pass
    sys.exit(f"pre-commit: cannot read easyprompting/manifest.json: {exc}")

if len(description) > 132:
    sys.exit(
        f"pre-commit: manifest.description is {len(description)} chars, "
        f"CWS allows 132.\n{description}"
    )
PY
